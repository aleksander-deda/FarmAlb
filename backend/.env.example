# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=FarmaAlb
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no setup needed)
DATABASE_URL=sqlite:///./farma_alb.db

# PostgreSQL (uncomment and fill when ready to switch)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ardhja

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local         # local | r2 | s3
STORAGE_LOCAL_PATH=./media
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_ENDPOINT=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console         # console | smtp | sendgrid
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@farmaalb.al

# ─── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_BOOKING_COMMISSION_RATE=0.10    # 10%
PLATFORM_ORDER_COMMISSION_RATE=0.08     # 8%
PLATFORM_DEFAULT_CURRENCY=ALL
